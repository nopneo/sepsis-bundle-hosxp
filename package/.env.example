# ไฟล์ตั้งค่า Sepsis Six Bundle — สคริปต์ติดตั้งสร้าง .env จากไฟล์นี้ให้อัตโนมัติ
# ห้ามส่งไฟล์ .env ให้ผู้อื่น (มีรหัสผ่านฐานข้อมูล) · แก้แล้วต้อง restart service หน้าเว็บ

# --- โรงพยาบาล ---
SEPSIS_HOSPITAL_NAME=โรงพยาบาล

# --- ฐานข้อมูล HOSxP (แนะนำ user ที่มีสิทธิ์ SELECT อย่างเดียว) ---
SEPSIS_DB_MODE=direct
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hos
DB_USER=
DB_PASS=

# --- พอร์ตหน้าเว็บ ---
PORT=5800

# --- รหัสรายการของโรงพยาบาล (setup_check.py --write เติมให้ ต้องตรวจทานเสมอ) ---
# คั่นหลายรหัสด้วยจุลภาค เช่น 1000187,1000183
SEPSIS_LACTATE_LAB_ITEMS=
SEPSIS_HEMOCULTURE_LAB_ITEMS=
SEPSIS_HEMOCULTURE_ICODES=
SEPSIS_IV_FLUID_ICODES=
# ยากระตุ้นความดัน (ตัวชี้วัด SSC 2026: norepinephrine เป็นตัวแรก)
SEPSIS_NOREPINEPHRINE_ICODES=
SEPSIS_DOPAMINE_ICODES=
# รหัส ward ที่เป็น ICU (ถ้ามี) ใช้นับ "refer/เข้า ICU ภายใน 6 ชม." — เว้นว่างถ้าไม่มี ICU
SEPSIS_ICU_WARDS=

# --- นิยาม bundle ---
# er = นับจากเวลารับรู้ sepsis -> triage -> เข้า ER (ค่าแรกที่มี) | admission = นับจากเวลา admit
SEPSIS_TIME_ZERO=er
SEPSIS_BUNDLE_MINUTES=60
SEPSIS_WINDOW_HOURS=24
# วัด Lactate ซ้ำภายในกี่ชั่วโมง (เมื่อค่าแรก > 2)
SEPSIS_LACTATE_REPEAT_HOURS=6

# --- การแจ้งเตือน ---
# การ์ดผล bundle หลังครบเวลา: 0 = ปิด | 1 = เปิด (แนะนำเปิดหลังทีมทวนผลในแดชบอร์ดแล้ว)
SEPSIS_SEND_BUNDLE_RESULT=0
SEPSIS_NOTIFY_GRACE_MINUTES=10
SEPSIS_MAX_ALERT_AGE_HOURS=6

# --- รหัสสถานะจำหน่าย (ค่าเริ่มต้นตามมาตรฐาน HOSxP — แก้เมื่อ รพ. ตั้งรหัสต่างไป) ---
# SEPSIS_OVSTOST_REFER=54
# SEPSIS_OVSTOST_DEATH=52,53
# SEPSIS_OVSTOST_REFUSE=96
# SEPSIS_OVSTOST_ESCAPE=97
# SEPSIS_OVSTOST_HOME=99
# SEPSIS_ER_DCH_REFER=2
# SEPSIS_ER_DCH_DEATH=4,6
# SEPSIS_ER_DCH_REFUSE=7
# SEPSIS_ER_DCH_ESCAPE=8
# SEPSIS_ER_DCH_HOME=1

# --- ความปลอดภัย / ประสิทธิภาพ (ไม่ใส่ก็ได้) ---
# รหัสผ่านหน้า /settings (ชื่อผู้ใช้อะไรก็ได้) — ไม่ตั้ง = เปิด /settings ได้เฉพาะจากเครื่องเซิร์ฟเวอร์เอง (127.0.0.1)
# SEPSIS_SETTINGS_PASSWORD=
# เวลาสูงสุดต่อคำสั่ง SQL (วินาที)
# SEPSIS_DB_TIMEOUT=60
# แคชผลของเคสที่พ้นช่วงค้นหาแล้ว (วินาที, 0 = ปิด)
# SEPSIS_CASE_CACHE_SECONDS=1800

# --- ทางเลือก: LINE Messaging API (ใช้เมื่อไม่ได้ตั้ง MOPH Notify ที่หน้า /settings) ---
# LINE_CHANNEL_ACCESS_TOKEN=
# LINE_TO=
