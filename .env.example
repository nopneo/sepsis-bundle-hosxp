# คัดลอกเป็น .env แล้ว chmod 600 (ห้าม commit ไฟล์ .env)

SEPSIS_HOSPITAL_NAME=โรงพยาบาลวังน้ำเขียว

# --- HOSxP DB ---
SEPSIS_DB_MODE=direct
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hos
DB_USER=<readonly_user>
DB_PASS=<password>
# ตอน dev จากเครื่องที่ไม่มีรหัส DB ให้ลบ DB_PASS ออก แล้วตั้ง SEPSIS_SSH_HOST ระบบจะใช้โหมด ssh
# SEPSIS_SSH_HOST=<ssh alias ของเครื่องฐานข้อมูล>

PORT=5500

# --- นิยาม bundle / time-zero ---
# er (แนะนำ) = เวลารับรู้ sepsis/triage/เข้า ER ตามที่มีบันทึก | admission = เวลา admit
SEPSIS_TIME_ZERO=er
SEPSIS_BUNDLE_MINUTES=60
SEPSIS_WINDOW_HOURS=24
SEPSIS_NOTIFY_GRACE_MINUTES=10
# การ์ดผล bundle ใน LINE: 0 = ปิด (ค่าเริ่มต้น) | 1 = เปิด
SEPSIS_SEND_BUNDLE_RESULT=0

# รหัส lab/ยา (ตรวจสอบแล้ว ต.ค. 2026 — โค้ดไม่มีค่าเริ่มต้นแล้ว ต้องมีใน .env · หาใหม่ด้วย setup_check.py)
SEPSIS_LACTATE_LAB_ITEMS=2240
SEPSIS_HEMOCULTURE_LAB_ITEMS=1986,727,728,729,730
SEPSIS_HEMOCULTURE_ICODES=3071625
SEPSIS_IV_FLUID_ICODES=1000187,1000183
SEPSIS_NOREPINEPHRINE_ICODES=1611001
SEPSIS_DOPAMINE_ICODES=1000119,1000342
# SEPSIS_ICU_WARDS=          (รพ.วังน้ำเขียวไม่มี ICU)
# SEPSIS_LACTATE_REPEAT_HOURS=6

# --- ความปลอดภัย / ประสิทธิภาพ (ไม่ใส่ก็ได้) ---
# รหัสผ่านหน้า /settings (ชื่อผู้ใช้อะไรก็ได้) — ไม่ตั้ง = เปิด /settings ได้เฉพาะจากเครื่องเซิร์ฟเวอร์เอง (127.0.0.1)
# SEPSIS_SETTINGS_PASSWORD=
# เวลาสูงสุดต่อคำสั่ง SQL (วินาที)
# SEPSIS_DB_TIMEOUT=60
# แคชผลของเคสที่พ้นช่วงค้นหาแล้ว (วินาที, 0 = ปิด)
# SEPSIS_CASE_CACHE_SECONDS=1800

# --- LINE Messaging API (ไม่ใช่ LINE Notify ที่ปิดไปแล้ว) ---
LINE_CHANNEL_ACCESS_TOKEN=<channel-access-token>
LINE_TO=<userId-หรือ-groupId-ปลายทาง>
